# API — 비우면 동일 오리진(/api) 사용 (Vite dev proxy)
VITE_API_BASE_URL=

# 미디어 — 비우면 /upload (dev proxy)
VITE_MEDIA_BASE_URL=

VITE_RECAPTCHA_SITE_KEY=

# HP API (document/hp_api_reference.md) — 운영 기본: ERP 54.116.87.172
# false → 로컬 FastAPI /api/contact, /api/quick-quote (uvicorn)
# true  → /api/hp/* (개발: Vite 프록시, 운영: VITE_HP_API_BASE_URL 직접 호출)
VITE_USE_HP_API=true
VITE_HP_API_BASE_URL=http://54.116.87.172
# 개발 시 BASE_URL 비우면 상대경로 /api/hp → Vite 프록시만 사용
VITE_HP_PROXY_TARGET=http://54.116.87.172

# Quote Wizard — false 시 /api/erp/* · /api/quote/wizard 연동 시도
VITE_WIZARD_USE_MOCK=true

VITE_GA_MEASUREMENT_ID=
VITE_APP_BASE_URL=http://localhost:5173

# 배포 (scripts/deploy-s3.ps1)
# CLOUDFRONT_DISTRIBUTION_ID=EAD1YVAYMLDS7
# CloudFront URL: https://dusftiakt754y.cloudfront.net
