# PostgreSQL (필수 — Innovo_homepage 기본 DB)
# 운영: ERP EC2 Private IP (VPC 내부 통신)
# 로컬 개발: localhost
POSTGRES_HOST=172.31.12.218
POSTGRES_PORT=5432
POSTGRES_DB=innovo_homepage
POSTGRES_USER=homepage_user
POSTGRES_PASSWORD=your_password_here

# 앱 설정
SECRET_KEY=replace_this_with_a_secure_random_string
APP_ENV=development

# Mailnara SMTP (Phase 3 — 문의·가입·Quick Quote 공통)
SMTP_HOST=smtp.mailnara.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=sbchung@innovotech.co.kr
SALES_NOTIFY_EMAIL=sbchung@innovotech.co.kr

# reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# 유형: v3 | 도메인: innovosolution.co.kr, www.innovosolution.co.kr, localhost, 127.0.0.1
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# 로컬 개발 시 true — 운영에서는 반드시 false
RECAPTCHA_SKIP_VERIFY=true

# Rate limit (분당 최대 요청 수, IP 기준)
RATE_LIMIT_PER_MINUTE=10

# JWT
ADMIN_SECRET_KEY=replace_admin_secret
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14
APP_BASE_URL=http://127.0.0.1:8000

# Contact upload
CONTACT_UPLOAD_MAX_BYTES=10485760
CONTACT_UPLOAD_DIR=upload/contact

# Admin seed (최초 1회 — staff 0건일 때만 생성)
ADMIN_SEED_EMAIL=sbchung@innovotech.co.kr
ADMIN_SEED_PASSWORD=1736gogo()
ADMIN_SEED_DISPLAY_NAME=Sales Manager
ADMIN_SEED_ROLES=sales_admin

# Phase 5 — ERP 연동
# 엔드포인트: POST {ERP_API_BASE_URL}/api/external/inquiry
# API Key는 ERP 개발자에게 발급 요청
ERP_API_BASE_URL=http://your-erp-server
ERP_API_KEY=your_erp_api_key_here
